---
// Cards for posts and notes with their description, date, tags, and difficulty, for the
// home, notebook contents, and tag pages. Sub-sections get their own heading and grid.
import { isSection, type Item } from '../lib/notebook';
import { entryUrl, formatDate, type Entry } from '../lib/site';
import NoteMeta from './NoteMeta.astro';

interface Props {
  items: (Item | Entry)[];
}

const { items } = Astro.props;
const notes = items.filter((item): item is Entry => !isSection(item));
const sections = items.filter(isSection);
---

<div class="flex flex-col gap-8">
  {
    notes.length > 0 && (
      <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3">
        {notes.map((note) => (
          <li class="relative flex flex-col gap-2 rounded-2xl bg-[#111] p-5 hover:bg-[#161616]">
            <a href={entryUrl(note)} class="text-[15px] font-medium tracking-[-0.01em] text-[#efefef] no-underline after:absolute after:inset-0 after:rounded-2xl">
              {note.data.title}
            </a>
            {note.data.description && <p class="m-0 line-clamp-2 text-[12.5px] leading-[1.7] text-[#7d7d7d]">{note.data.description}</p>}
            {note.data.date && (
              <time class="font-[DM_Mono,ui-monospace,monospace] text-[11px] leading-none text-[#6f6f6f] tabular-nums" datetime={formatDate(note.data.date)}>
                {formatDate(note.data.date)}
              </time>
            )}
            <div class="relative mt-auto pt-2 empty:hidden">
              <NoteMeta entry={note} />
            </div>
          </li>
        ))}
      </ul>
    )
  }
  {
    sections.map((section) => (
      <section class="flex flex-col gap-4">
        <h3 class="m-0 text-[13px] font-medium text-[#6f6f6f]">{section.title}</h3>
        <Astro.self items={section.items} />
      </section>
    ))
  }
</div>
