---
// Top bar on the home, notebook contents, tag, post, and 404 pages. With `back`, it shows only a
// back button and a title (notebook contents and post pages).
import BackLink from './BackLink.astro';

interface Props {
  back?: { href: string; title: string };
}

const { back } = Astro.props;
---

<header class="flex min-h-[28px] items-center justify-between gap-6">
  {
    back ? (
      <BackLink href={back.href} title={back.title} />
    ) : (
      <>
        <a href="/" class="text-[15px] font-semibold tracking-[-0.035em] text-[#efefef] no-underline">Blogs</a>
        <span class="text-[13px] font-medium tracking-[-0.01em] text-[#8a8a8a]">By Jimmy Wu</span>
      </>
    )
  }
</header>
