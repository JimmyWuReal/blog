---
// The nav bar on every page, stuck to the top while scrolling. It spans the same 1120px column
// as the page below it. On the home, tag, and 404 pages it shows the site name; elsewhere a
// back button and a breadcrumb such as "Competitive Programming / Hello World!". Views comes right
// after the site name, or on the right of a breadcrumb.
interface Props {
  /** Where the back button goes. Omit for the site-name header. */
  back?: string;
  /** Let Base's script repoint the back button at the note or notebook the reader came from. */
  latest?: boolean;
  /** The breadcrumb beside the back button; the last crumb is the current page. */
  crumbs?: { title: string; href?: string }[];
}

const { back, latest, crumbs = [] } = Astro.props;
// The pathname is /views in dev and /views.html in the build.
const onViews = /^\/views(?:\.html)?$/.test(Astro.url.pathname);
---

<!-- The top margin scrolls away, so the bar sits 32px down at first and flush once stuck. -->
<header class="sticky top-0 z-10 mt-4 bg-[#090909]">
  <div class="mx-auto flex max-w-[1120px] items-center justify-between gap-6 px-4 py-4 sm:px-10">
    {
      back ? (
        // The negative margin lines the back chevron up with the content below it.
        <nav aria-label="Breadcrumb" class="-ml-[11px] flex h-[28px] min-w-0 items-center gap-3">
          <a href={back} class="nav-back icon-button is-small is-plain shrink-0" aria-label="Back" data-back={latest ? '' : undefined}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
          </a>
          <ol class="flex min-w-0 items-center gap-2 text-[15px] leading-[1.3] font-semibold tracking-[-0.035em]">
            {crumbs.map((crumb, i) => {
              const current = i === crumbs.length - 1;
              // The crumb right before the page title is where the back button leads, so the two light up together.
              const parent = i === crumbs.length - 2;
              return (
                // On a narrow screen the parent crumbs give up their width faster than the page title.
                <li class:list={['flex min-w-0 items-center gap-2', !current && 'shrink-[3]']}>
                  {i > 0 && <span class="text-[#4a4a4a]" aria-hidden="true">/</span>}
                  {current || !crumb.href ? (
                    <span class="truncate text-[#efefef]" aria-current={current ? 'page' : undefined}>{crumb.title}</span>
                  ) : (
                    <a href={crumb.href} class:list={['crumb-link truncate text-[#8a8a8a] no-underline', parent && 'nav-parent']}>{crumb.title}</a>
                  )}
                </li>
              );
            })}
          </ol>
        </nav>
      ) : (
        <div class="flex items-center gap-5 text-[15px] leading-[28px] font-semibold tracking-[-0.035em]">
          <a href="/" class="text-[#efefef] no-underline">Blogs</a>
          <a href="/views" class="nav-link no-underline" aria-current={onViews ? 'page' : undefined}>Views</a>
        </div>
      )
    }
    <div class="shrink-0 text-[13px] leading-[28px] font-medium tracking-[-0.01em] text-[#8a8a8a]">
      {back ? <a href="/views" class="nav-link no-underline">Views</a> : 'By Jimmy Wu'}
    </div>
  </div>
</header>

<style>
  .crumb-link { transition: color 180ms ease-out; }
  .nav-link { position: relative; color: #8a8a8a; transition: color 180ms ease-out; }
  .nav-link:hover, .nav-link[aria-current] { color: #efefef; }
  .crumb-link:hover,
  nav:has(.nav-back:hover) .nav-parent { color: #efefef; }
  nav:has(.nav-parent:hover) .nav-back { color: #fff; }
  /* A 44px target for fingers, around the same text. */
  @media (pointer: coarse) {
    .nav-link::after { content: ''; position: absolute; inset: 50% auto auto 50%; width: max(100%, 44px); height: 44px; transform: translate(-50%, -50%); }
  }
</style>
