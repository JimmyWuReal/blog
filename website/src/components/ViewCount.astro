---
// A live view count from Convex: " · 1,234 views", or "1,234 views" with an empty prefix.
// `count` adds a view of the post or note at `path` (once per browser tab); otherwise the count is
// only read, as for a notebook's total or a card. The script in layouts/Base.astro fills it in;
// it stays invisible (but keeps its prefix's space) until then, and isn't rendered at all when
// CONVEX_URL isn't set.
interface Props {
  /** A counter from viewPath (cp/math/fast-power, posts/hello) or a notebook slug (cp). */
  path: string;
  count?: boolean;
  /** Text before the count; cards pass '' to show it on its own. */
  prefix?: string;
}

const { path, count = false, prefix = ' · ' } = Astro.props;
const url = import.meta.env.CONVEX_URL;
---

{
  url && (
    <span
      data-views={path}
      data-count={count ? '' : undefined}
      class="opacity-0 transition-opacity duration-300 ease-out data-loaded:opacity-100 motion-reduce:transition-none"
    >
      {prefix}<span data-views-value />
    </span>
  )
}
