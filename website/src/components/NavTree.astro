---
// The notebook tree from notebook.yml. Renders itself for sub-sections.
import { isSection, noteUrl, type Item } from '../lib/notebook';

interface Props {
  items: Item[];
  currentId?: string;
}

const { items, currentId } = Astro.props;
---

<ul class="flex flex-col gap-px">
  {
    items.map((item) =>
      isSection(item) ? (
        <li class="mt-3 mb-1 pl-3">
          <p class="nav-section mb-1">{item.title}</p>
          <Astro.self items={item.items} currentId={currentId} />
        </li>
      ) : (
        <li>
          <a class="nav-link" href={noteUrl(item)} aria-current={item.id === currentId ? 'page' : undefined}>
            {item.data.title}
          </a>
        </li>
      ),
    )
  }
</ul>
