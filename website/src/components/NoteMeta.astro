---
// A post's or note's date, authors, tags, and difficulty, all in DM Mono so the meta reads as one.
// Slotted content, such as the article's view count, ends the date and author line.
import { formatAuthors, formatDate, type Entry } from '../lib/site';

interface Props {
  entry: Entry;
}

const { date, author, tags, difficulty } = Astro.props.entry.data;
---

<div class="flex flex-col gap-3 font-[DM_Mono,ui-monospace,monospace] text-[12px] text-[#8a8a8a] tabular-nums">
  <p class="m-0 leading-relaxed [overflow-wrap:anywhere]">
    {date && <><time datetime={formatDate(date)}>{formatDate(date)}</time>{' · '}</>}
    by {formatAuthors(author)}
    <slot />
  </p>
  {
    (tags.length > 0 || difficulty !== undefined) && (
      <div class="relative flex flex-wrap items-center gap-2">
        {tags.map((tag) => (
          <a class="tag" href={`/tags/${encodeURIComponent(tag)}`}>
            {tag}
          </a>
        ))}
        {difficulty !== undefined && (
          <span class="tag" title="Difficulty, 0 (easiest) to 10">
            difficulty {difficulty}/10
          </span>
        )}
      </div>
    )
  }
</div>
