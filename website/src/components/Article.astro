---
// The reading view of a post or note: title, meta, rendered markdown, and "On this page".
// Code blocks get a copy button. The page puts SiteHeader above it.
import { render } from 'astro:content';
import NoteMeta from './NoteMeta.astro';
import type { Entry } from '../lib/site';
import '../styles/note.css';

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth >= 1 && h.depth <= 3);
// Indent each level relative to the shallowest heading, so a post without an H1 isn't shifted right
const tocBase = Math.min(...toc.map((h) => h.depth));
---

<!-- The same 1120px column as the home page, with the article centered in it. On wide screens
     "On this page" sits as ticks just left of the article. -->
<div class="mx-auto grid max-w-[1120px] grid-cols-[minmax(0,740px)] justify-center gap-x-8 px-4 pt-6 pb-10 sm:px-10 lg:pt-12 lg:pb-16 xl:grid-cols-[minmax(0,1fr)_minmax(0,740px)_minmax(0,1fr)]">
  <main class="min-w-0 xl:col-start-2 xl:row-start-1">
    <h1 class="m-0 text-[32px] leading-[1.2] font-medium tracking-[-0.035em] sm:text-[36px]">{entry.data.title}</h1>
    <div class="mt-4"><NoteMeta entry={entry} /></div>

    {
      entry.data.pre.length > 0 && (
        <section aria-label="先備知識" class="mt-8 text-[14px] leading-[1.75] text-[#b8b8b8] [overflow-wrap:anywhere]">
          <h2 class="mb-2 font-medium text-white">先備知識</h2>
          <ul class="list-disc space-y-1 pl-6">
            {entry.data.pre.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      )
    }

    <article class="note mt-10">
      <Content />
    </article>
  </main>

  {
    toc.length > 0 && (
      <aside class="toc-scroller sticky top-[84px] z-10 -mx-4 -mt-3 hidden max-h-[calc(100vh-7rem)] self-start overflow-y-auto px-4 py-3 xl:col-start-1 xl:row-start-1 xl:block">
        <!-- "On this page" as quiet ticks: longer = higher level. Hovering (or tabbing into) the
             ticks opens a panel with the titles; one white marker glides to the section being read.
             The panel stays inside the TOC column and its gap, never over the note; the aside's
             padding gives it room so the scroller doesn't clip its edges. -->
        <nav aria-label="On this page" class="toc" data-toc>
          <ul>
            {toc.map((h) => (
              <li style={`--level:${h.depth - tocBase}`}>
                <a href={`#${h.slug}`} class="toc-link" title={h.text}>
                  <span class="toc-tick" aria-hidden="true" />
                  <span class="toc-label">{h.text}</span>
                </a>
              </li>
            ))}
          </ul>
          <span class="toc-marker" aria-hidden="true" />
        </nav>
      </aside>
    )
  }
</div>

<style>
  .toc-scroller { scrollbar-width: none; }
  .toc-scroller::-webkit-scrollbar { display: none; }

  .toc { position: relative; isolation: isolate; }
  .toc ul { margin: 0; padding: 0; list-style: none; }

  /* Fixed 24px rows keep the ticks evenly spaced; titles are laid over the note, not in the row */
  .toc-link { position: relative; display: flow-root; height: 24px; text-decoration: none; }

  /* 20px / 14px / 8px for each level down */
  .toc-tick {
    display: block;
    width: calc(20px - var(--level) * 6px);
    height: 2px;
    margin-top: 11px;
    border-radius: 2px;
    background: #343434;
    transition: background-color 200ms ease;
  }
  .toc:hover .toc-tick { background: #4a4a4a; }
  .toc .toc-link:hover .toc-tick { background: #8c8c8c; }

  .toc-label {
    position: absolute;
    top: 0;
    left: 32px;
    right: 0;
    padding-left: calc(var(--level) * 10px);
    overflow: hidden;
    font-size: 12.5px;
    line-height: 24px;
    color: #8c8c8c;
    white-space: nowrap;
    text-overflow: ellipsis;
    visibility: hidden;
    opacity: 0;
    transform: translateX(-4px);
    transition: color 200ms ease, opacity 160ms ease-out, transform 200ms cubic-bezier(0.22, 1, 0.36, 1), visibility 0s 200ms;
  }
  .toc-link:hover .toc-label,
  .toc-link.is-active .toc-label { color: #fff; }

  /* The panel behind the ticks and titles, raised off the page like the kit's menus */
  .toc::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: -10px;
    bottom: -10px;
    left: -14px;
    right: -14px;
    border-radius: 12px;
    background: #141414;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.07);
    transform-origin: 0 0;
    visibility: hidden;
    opacity: 0;
    transform: translateX(-4px) scale(0.98);
    transition: opacity 160ms ease-out, transform 240ms cubic-bezier(0.22, 1, 0.36, 1), visibility 0s 240ms;
  }

  /* Open: the panel settles first, then the titles follow, as the kit's accordion does. A short
     delay keeps a pointer passing over the ticks from flashing it. Closing has no delay. */
  .toc:is(:hover, :has(:focus-visible))::before {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition-delay: 60ms, 60ms, 0s;
  }
  .toc:is(:hover, :has(:focus-visible)) .toc-label {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition-delay: 0s, 120ms, 120ms, 0s;
  }

  /* One marker moves between ticks rather than each tick lighting up. It mounts in place (no
     transition) and only starts gliding once it has been placed. */
  .toc-marker {
    position: absolute;
    top: 0;
    left: 0;
    height: 2px;
    border-radius: 2px;
    background: #fff;
    opacity: 0;
    pointer-events: none;
  }
  .toc-marker.is-placed { opacity: 1; }
  .toc-marker.is-ready { transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1), width 320ms cubic-bezier(0.22, 1, 0.36, 1); }
</style>

<script>
  // Copy button on every code block
  const copyIcon = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>';
  const checkIcon = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';
  for (const pre of document.querySelectorAll<HTMLPreElement>('.note pre')) {
    const block = document.createElement('div');
    block.className = 'code-block';
    pre.replaceWith(block);
    block.append(pre);
    const anchor = document.createElement('span');
    anchor.className = 'code-copy tooltip-anchor';
    anchor.innerHTML = `<span class="tooltip" aria-hidden="true">Copy</span><button class="icon-button is-small" type="button" aria-label="Copy code">${copyIcon}</button>`;
    block.append(anchor);
    const button = anchor.querySelector('button')!;
    const tip = anchor.querySelector('.tooltip')!;
    let timer: number | undefined;
    button.addEventListener('click', async () => {
      const code = [...pre.querySelectorAll('.line')].map((line) => line.textContent).join('\n') || pre.innerText;
      try {
        await navigator.clipboard.writeText(code);
      } catch {
        return;
      }
      tip.textContent = 'Copied';
      button.innerHTML = checkIcon;
      button.setAttribute('aria-label', 'Copied');
      anchor.classList.add('is-shown');
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        tip.textContent = 'Copy';
        button.innerHTML = copyIcon;
        button.setAttribute('aria-label', 'Copy code');
        anchor.classList.remove('is-shown');
      }, 1600);
    });
  }

  // "On this page": highlight the section being read, glide the marker to its tick, keep that tick
  // in view when the list is taller than the screen, and smooth-scroll on click.
  const toc = document.querySelector<HTMLElement>('[data-toc]');
  const scroller = toc?.closest<HTMLElement>('.toc-scroller');
  const marker = toc?.querySelector<HTMLElement>('.toc-marker');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc] .toc-link')];
  const targets = links.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))));
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
  let frame = 0;
  let current = -1;
  // While a click's smooth scroll runs, keep the clicked section active instead of stepping through
  // every section on the way. Unlock once the page has been still for a moment; this works in every
  // browser, unlike scrollend. The spy then waits for the next real scroll, so a section near the
  // page bottom that can't reach the top stays active after its click.
  let locked = false;
  let unlockTimer = 0;
  const unlockWhenStill = () => {
    clearTimeout(unlockTimer);
    unlockTimer = window.setTimeout(() => (locked = false), 150);
  };

  const place = () => {
    const tick = links[current]?.querySelector<HTMLElement>('.toc-tick');
    if (!toc || !scroller || !marker || !tick || !tick.offsetWidth) return; // hidden below xl
    const tickBox = tick.getBoundingClientRect();
    marker.style.transform = `translateY(${tickBox.top - toc.getBoundingClientRect().top}px)`;
    marker.style.width = `${tick.offsetWidth}px`;
    const ready = marker.classList.contains('is-ready');
    if (!marker.classList.contains('is-placed')) {
      marker.classList.add('is-placed');
      requestAnimationFrame(() => requestAnimationFrame(() => marker.classList.add('is-ready')));
    }
    // Long lists: keep the current tick near the middle rather than at the edge or out of sight
    if (scroller.scrollHeight > scroller.clientHeight) {
      const y = tickBox.top - scroller.getBoundingClientRect().top + scroller.scrollTop;
      scroller.scrollTo({ top: y - scroller.clientHeight / 2, behavior: ready && !reduceMotion.matches ? 'smooth' : 'instant' });
    }
  };
  const activate = (index: number) => {
    if (index === current) return;
    current = index;
    links.forEach((link, i) => link.classList.toggle('is-active', i === current));
    place();
  };
  const spy = () => {
    frame = 0;
    if (locked) return;
    let next = 0;
    targets.forEach((el, i) => el && el.getBoundingClientRect().top < 120 && (next = i));
    activate(next);
  };

  links.forEach((link, i) =>
    link.addEventListener('click', (event) => {
      const target = targets[i];
      if (!target) return;
      event.preventDefault();
      history.pushState(null, '', link.hash);
      activate(i);
      locked = true;
      unlockWhenStill();
      target.scrollIntoView({ behavior: reduceMotion.matches ? 'auto' : 'smooth', block: 'start' });
    }),
  );

  if (links.length) {
    addEventListener('scroll', () => (locked ? unlockWhenStill() : (frame ||= requestAnimationFrame(spy))), { passive: true });
    // Fonts and the xl breakpoint can move the ticks, so re-measure without changing the section
    addEventListener('resize', place);
    document.fonts?.ready.then(place);
    spy();
  }
</script>
