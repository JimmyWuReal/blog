---
// The reading view of a post or note: title, meta, rendered markdown, and "On this page".
// Code blocks get a copy button. The page puts SiteHeader above it.
import { render } from 'astro:content';
import NoteMeta from './NoteMeta.astro';
import type { Entry } from '../lib/site';
import '../styles/note.css';

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth >= 1 && h.depth <= 3);
// Indent each level relative to the shallowest heading, so a post without an H1 isn't shifted right
const tocBase = Math.min(...toc.map((h) => h.depth));
---

<!-- The same 1120px column as the home page, with the article centered in it. On wide screens
     "On this page" fills the space to its left, starting at the nav bar's left edge. -->
<div class="mx-auto grid max-w-[1120px] grid-cols-[minmax(0,740px)] justify-center gap-x-8 px-4 pt-6 pb-10 sm:px-10 lg:pt-12 lg:pb-16 xl:grid-cols-[minmax(0,1fr)_minmax(0,740px)_minmax(0,1fr)]">
  <main class="min-w-0 xl:col-start-2 xl:row-start-1">
    <h1 class="m-0 text-[32px] leading-[1.2] font-medium tracking-[-0.035em] sm:text-[36px]">{entry.data.title}</h1>
    <div class="mt-4"><NoteMeta entry={entry} /></div>

    {
      entry.data.pre.length > 0 && (
        <section aria-label="先備知識" class="mt-8 text-[14px] leading-[1.75] text-[#b8b8b8] [overflow-wrap:anywhere]">
          <h2 class="mb-2 font-medium text-white">先備知識</h2>
          <ul class="list-disc space-y-1 pl-6">
            {entry.data.pre.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      )
    }

    <article class="note mt-10">
      <Content />
    </article>
  </main>

  {
    toc.length > 0 && (
      <aside class="sticky top-24 hidden max-h-[calc(100vh-8rem)] self-start overflow-y-auto xl:col-start-1 xl:row-start-1 xl:block">
        <!-- "On this page" as quiet ticks: longer = higher level. Hovering (or tabbing into) the nav
             reveals the titles; one white marker glides to the section being read. -->
        <nav aria-label="On this page" class="toc" data-toc>
          <ul>
            {toc.map((h) => (
              <li style={`--level:${h.depth - tocBase}`}>
                <a href={`#${h.slug}`} class="toc-link">
                  <span class="toc-tick" aria-hidden="true" />
                  <span class="toc-label">{h.text}</span>
                </a>
              </li>
            ))}
          </ul>
          <span class="toc-marker" aria-hidden="true" />
        </nav>
      </aside>
    )
  }
</div>

<style>
  .toc { position: relative; padding-top: 6px; }
  .toc ul { margin: 0; padding: 0; list-style: none; }

  /* The link spans the column so the pointer can travel from tick to title without losing hover */
  .toc-link { display: flex; align-items: flex-start; gap: 12px; padding: 3px 0; text-decoration: none; }

  /* 20px / 14px / 8px for each level down; the label column stays fixed so titles line up */
  .toc-tick {
    flex: none;
    width: calc(20px - var(--level) * 6px);
    height: 2px;
    margin: 8px calc(var(--level) * 6px) 0 0;
    border-radius: 2px;
    background: #343434;
    transition: background-color 200ms ease;
  }
  .toc-label {
    padding-left: calc(var(--level) * 8px);
    font-size: 12.5px;
    line-height: 1.45;
    color: #8c8c8c;
    overflow-wrap: anywhere;
    transition: color 200ms ease, opacity 160ms ease-out, transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .toc-link:hover .toc-label,
  .toc-link.is-active .toc-label { color: #fff; }
  .toc-link:hover .toc-tick { background: #8c8c8c; }

  /* Titles stay in the layout while hidden, so the ticks never shift when they appear */
  @media (hover: hover) {
    .toc-label { opacity: 0; transform: translateX(-4px); }
    .toc:hover .toc-label,
    .toc:has(:focus-visible) .toc-label { opacity: 1; transform: none; }
    .toc:hover .toc-tick { background: #4a4a4a; }
    .toc .toc-link:hover .toc-tick { background: #8c8c8c; }
  }

  /* One marker moves between ticks rather than each tick lighting up. It mounts in place (no
     transition) and only starts gliding once it has been placed. */
  .toc-marker {
    position: absolute;
    top: 0;
    left: 0;
    height: 2px;
    border-radius: 2px;
    background: #fff;
    opacity: 0;
    pointer-events: none;
  }
  .toc-marker.is-placed { opacity: 1; }
  .toc-marker.is-ready { transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1), width 320ms cubic-bezier(0.22, 1, 0.36, 1); }
</style>

<script>
  // Copy button on every code block
  const copyIcon = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>';
  const checkIcon = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';
  for (const pre of document.querySelectorAll<HTMLPreElement>('.note pre')) {
    const block = document.createElement('div');
    block.className = 'code-block';
    pre.replaceWith(block);
    block.append(pre);
    const anchor = document.createElement('span');
    anchor.className = 'code-copy tooltip-anchor';
    anchor.innerHTML = `<span class="tooltip" aria-hidden="true">Copy</span><button class="icon-button is-small" type="button" aria-label="Copy code">${copyIcon}</button>`;
    block.append(anchor);
    const button = anchor.querySelector('button')!;
    const tip = anchor.querySelector('.tooltip')!;
    let timer: number | undefined;
    button.addEventListener('click', async () => {
      const code = [...pre.querySelectorAll('.line')].map((line) => line.textContent).join('\n') || pre.innerText;
      try {
        await navigator.clipboard.writeText(code);
      } catch {
        return;
      }
      tip.textContent = 'Copied';
      button.innerHTML = checkIcon;
      button.setAttribute('aria-label', 'Copied');
      anchor.classList.add('is-shown');
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        tip.textContent = 'Copy';
        button.innerHTML = copyIcon;
        button.setAttribute('aria-label', 'Copy code');
        anchor.classList.remove('is-shown');
      }, 1600);
    });
  }

  // Highlight the section being read in "On this page" and glide the marker to its tick
  const toc = document.querySelector<HTMLElement>('[data-toc]');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc] .toc-link')];
  const targets = links.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))));
  const marker = toc?.querySelector<HTMLElement>('.toc-marker');
  let frame = 0;
  let current = -1;
  const place = () => {
    const tick = links[current]?.querySelector<HTMLElement>('.toc-tick');
    if (!toc || !marker || !tick || !tick.offsetWidth) return; // hidden below xl
    const y = tick.getBoundingClientRect().top - toc.getBoundingClientRect().top;
    marker.style.transform = `translateY(${y}px)`;
    marker.style.width = `${tick.offsetWidth}px`;
    if (!marker.classList.contains('is-placed')) {
      marker.classList.add('is-placed');
      requestAnimationFrame(() => requestAnimationFrame(() => marker.classList.add('is-ready')));
    }
  };
  const spy = () => {
    frame = 0;
    let next = 0;
    targets.forEach((el, i) => el && el.getBoundingClientRect().top < 120 && (next = i));
    if (next === current) return;
    current = next;
    links.forEach((link, i) => link.classList.toggle('is-active', i === current));
    place();
  };
  if (links.length) {
    addEventListener('scroll', () => (frame ||= requestAnimationFrame(spy)), { passive: true });
    // Fonts and the xl breakpoint can move the ticks, so re-measure without changing the section
    addEventListener('resize', place);
    document.fonts?.ready.then(place);
    spy();
  }
</script>
