---
// A back button beside a title: the notebook nav bar in place of the site header.
interface Props {
  href: string;
  title: string;
}

const { href, title } = Astro.props;
---

<div class="flex min-w-0 items-center gap-3">
  <a href={href} class="icon-button is-small shrink-0" aria-label="Back">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
  </a>
  <span class="text-[15px] leading-[1.3] font-semibold tracking-[-0.035em] text-[#efefef]">{title}</span>
</div>
