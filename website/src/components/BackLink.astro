---
// A back button beside a title: the notebook nav bar in place of the site header. With
// `latest`, Base's script repoints it at the note or notebook the reader came from.
interface Props {
  href: string;
  title: string;
  latest?: boolean;
}

const { href, title, latest } = Astro.props;
---

<div class="flex min-w-0 items-center gap-3">
  <a href={href} class="icon-button is-small is-plain shrink-0" aria-label="Back" data-back={latest ? '' : undefined}>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
  </a>
  <span class="truncate text-[15px] leading-[1.3] font-semibold tracking-[-0.035em] text-[#efefef]" data-back-label={latest ? '' : undefined}>{title}</span>
</div>
