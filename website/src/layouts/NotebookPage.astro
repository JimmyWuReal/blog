---
// A note's page: the nav bar reads "Notebook / Note". Its back button starts at the notebook's
// contents, and Base's script points it at the last note or notebook the reader came from.
import Base from './Base.astro';
import Article from '../components/Article.astro';
import SiteHeader from '../components/SiteHeader.astro';
import type { Note, Notebook } from '../lib/notebook';

interface Props {
  notebook: Notebook;
  note: Note;
}

const { notebook, note } = Astro.props;
---

<Base title={note.data.title} context={notebook.title} description={note.data.description} image={`/og/${note.id}.png`} type="article" kind="note">
  <SiteHeader back={`/${notebook.slug}`} latest crumbs={[{ title: notebook.title, href: `/${notebook.slug}` }, { title: note.data.title }]} />
  <Article entry={note} />
</Base>
