---
// A note's page: a nav bar above the centered note. The nav shows only a back button and the
// latest page's title; it starts at the notebook's contents, and Base's script points it at
// the last note or notebook the reader came from.
import Base from './Base.astro';
import BackLink from '../components/BackLink.astro';
import type { Note, Notebook } from '../lib/notebook';

interface Props {
  notebook: Notebook;
  note: Note;
}

const { notebook, note } = Astro.props;
---

<Base title={note.data.title} context={notebook.title} description={note.data.description} image={`/og/${note.id}.png`} type="article" kind="note">
  <header class="mx-auto flex min-h-[28px] max-w-[1120px] items-center px-4 pt-8 sm:px-10">
    <BackLink href={`/${notebook.slug}`} title={notebook.title} latest />
  </header>
  <slot />
</Base>
