---
import '../styles/global.css';
import { SITE_TITLE } from '../lib/site';

interface Props {
  /** Page title; `context` is appended. Omit on the home page. */
  title?: string;
  /** What the page belongs to, after its title in the browser tab. Defaults to the site title. */
  context?: string;
  /** Link-preview text. Omitted when empty. */
  description?: string;
  /** Path of the page's Open Graph image, from src/pages/og. */
  image?: string;
  /** `article` for posts and notes, `website` for everything else. */
  type?: 'website' | 'article';
  /** Notes and notebook contents pages are where a note's back button can return to. */
  kind?: 'note' | 'notebook';
}

const { title, context = SITE_TITLE, description, image = '/og/index.png', type = 'website', kind } = Astro.props;
const fullTitle = title ? `${title} · ${context}` : SITE_TITLE;
// In the build, pathname is the output file (/math/fast-power.html, /index.html); the
// public URL drops the extension, and the home page is /.
const url = new URL(Astro.url.pathname.replace(/(?:\/index)?\.html$/, '') || '/', Astro.site);
const imageUrl = new URL(image, Astro.site);
const convexUrl = import.meta.env.CONVEX_URL;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={url} />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}

    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title ?? SITE_TITLE} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    {/* Opens the connection for the view counts while the page is still loading. */}
    {convexUrl && <link rel="preconnect" href={convexUrl} crossorigin />}
  </head>
  <body data-page-title={title ?? SITE_TITLE} data-page-kind={kind}>
    <slot />
    {
      convexUrl && (
        <script is:inline define:vars={{ convexUrl }}>
          // Fills every ViewCount on the page. It's inline at the end of the body and calls
          // Convex's HTTP API with plain fetch (no Convex client to download), so the requests
          // start as soon as the page is parsed.
          for (const el of document.querySelectorAll('[data-views]')) {
            const path = el.dataset.views;
            const show = (n) => {
              el.querySelector('[data-views-value]').textContent = `${n.toLocaleString('en-US')} ${n === 1 ? 'view' : 'views'}`;
              el.dataset.loaded = '';
            };
            // Show the last count this browser saw right away; the live count replaces it.
            try {
              const last = localStorage.getItem(`views:${path}`);
              if (last !== null) show(Number(last));
            } catch {}
            // A reload in the same tab reads the count instead of adding another view.
            let seen = true;
            if (el.dataset.count !== undefined) {
              try {
                seen = sessionStorage.getItem(`viewed:${path}`) !== null;
                sessionStorage.setItem(`viewed:${path}`, '');
              } catch {
                seen = false;
              }
            }
            fetch(`${convexUrl}/api/${seen ? 'query' : 'mutation'}`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ path: seen ? 'views:get' : 'views:hit', args: { path }, format: 'json' }),
            })
              .then((res) => res.json())
              .then((res) => {
                if (res.status !== 'success') return;
                show(res.value);
                try {
                  localStorage.setItem(`views:${path}`, String(res.value));
                } catch {}
              })
              .catch(() => {});
          }
        </script>
      )
    }
  </body>
</html>

<script>
  // Keep this tab's visits as a stack in sessionStorage (following a link pushes, going
  // back to the previous page pops), so a note's back button can return to the page the
  // reader came from when that page is a note or a notebook.
  type Visit = { url: string; title: string; kind?: string };
  const KEY = 'visits';

  const load = (): Visit[] => {
    try {
      return JSON.parse(sessionStorage.getItem(KEY) ?? '[]');
    } catch {
      return [];
    }
  };

  addEventListener('pageshow', () => {
    const url = location.pathname;
    const { pageTitle = '', pageKind } = document.body.dataset;
    const visits = load();
    if (visits.at(-2)?.url === url) visits.pop();
    else if (visits.at(-1)?.url !== url) visits.push({ url, title: pageTitle, kind: pageKind });
    try {
      sessionStorage.setItem(KEY, JSON.stringify(visits.slice(-50)));
    } catch {}

    const back = document.querySelector<HTMLAnchorElement>('[data-back]');
    const prev = visits.at(-2);
    if (back && prev?.kind) back.href = prev.url;
  });
</script>
