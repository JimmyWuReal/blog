---
import '../styles/global.css';
import { SITE_TITLE } from '../lib/site';

interface Props {
  /** Page title; `context` is appended. Omit on the home page. */
  title?: string;
  /** What the page belongs to, after its title in the browser tab. Defaults to the site title. */
  context?: string;
  /** Link-preview text. Omitted when empty. */
  description?: string;
  /** Path of the page's Open Graph image, from src/pages/og. */
  image?: string;
  /** `article` for posts and notes, `website` for everything else. */
  type?: 'website' | 'article';
  /** Notes and notebook contents pages are where a note's back link can return to. */
  kind?: 'note' | 'notebook';
}

const { title, context = SITE_TITLE, description, image = '/og/index.png', type = 'website', kind } = Astro.props;
const fullTitle = title ? `${title} · ${context}` : SITE_TITLE;
// In the build, pathname is the output file (/math/fast-power.html, /index.html); the
// public URL drops the extension, and the home page is /.
const url = new URL(Astro.url.pathname.replace(/(?:\/index)?\.html$/, '') || '/', Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={url} />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}

    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title ?? SITE_TITLE} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body data-page-title={title ?? SITE_TITLE} data-page-kind={kind}>
    <slot />
  </body>
</html>

<script>
  // Keep this tab's visits as a stack in sessionStorage (following a link pushes, going
  // back to the previous page pops), so a note's back link can return to the page the
  // reader came from when that page is a note or a notebook.
  type Visit = { url: string; title: string; kind?: string };
  const KEY = 'visits';

  const load = (): Visit[] => {
    try {
      return JSON.parse(sessionStorage.getItem(KEY) ?? '[]');
    } catch {
      return [];
    }
  };

  addEventListener('pageshow', () => {
    const url = location.pathname;
    const { pageTitle = '', pageKind } = document.body.dataset;
    const visits = load();
    if (visits.at(-2)?.url === url) visits.pop();
    else if (visits.at(-1)?.url !== url) visits.push({ url, title: pageTitle, kind: pageKind });
    try {
      sessionStorage.setItem(KEY, JSON.stringify(visits.slice(-50)));
    } catch {}

    const back = document.querySelector<HTMLAnchorElement>('[data-back]');
    const prev = visits.at(-2);
    if (back && prev?.kind) {
      back.href = prev.url;
      document.querySelector('[data-back-label]')!.textContent = prev.title;
    }
  });
</script>
