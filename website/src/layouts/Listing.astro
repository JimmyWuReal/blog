---
// Wide page for the home, notebook contents, tag, and 404 pages.
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title?: string;
  description?: string;
  /** Open Graph image path; defaults to the home page's. */
  image?: string;
  /** Show only a back button and this title in the header, as on a notebook's contents page. */
  back?: { href: string; title: string };
  /** Lets a note's back link return to this page; see Base. */
  kind?: 'notebook';
}

const { back, ...base } = Astro.props;
---

<Base {...base}>
  <div class="mx-auto max-w-[1120px] px-4 pt-8 pb-24 sm:px-10">
    <SiteHeader back={back} />
    <main class="mt-10">
      <slot />
    </main>
  </div>
</Base>
