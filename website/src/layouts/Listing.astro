---
// Wide page for the home, notebook contents, tag, and 404 pages.
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title?: string;
  description?: string;
  /** Open Graph image path; defaults to the home page's. */
  image?: string;
}
---

<Base {...Astro.props}>
  <div class="mx-auto max-w-[1120px] px-4 pt-8 pb-24 sm:px-10">
    <SiteHeader />
    <main class="mt-16 sm:mt-20">
      <slot />
    </main>
  </div>
</Base>
