---
// Wide page for the home, notebook contents, tag, and 404 pages.
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title?: string;
  description?: string;
  /** Open Graph image path; defaults to the home page's. */
  image?: string;
  /** Show a back button and this title in the nav bar, as on a notebook's contents page. */
  back?: { href: string; title: string };
  /** Lets a note's back link return to this page; see Base. */
  kind?: 'notebook';
}

const { back, ...base } = Astro.props;
---

<Base {...base}>
  <SiteHeader back={back?.href} crumbs={back && [{ title: back.title }]} />
  <main class="mx-auto max-w-[1120px] px-4 pt-6 pb-24 sm:px-10">
    <slot />
  </main>
</Base>
