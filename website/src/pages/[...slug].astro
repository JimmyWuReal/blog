---
// One page per note, in HackMD's book layout: notebook tree, note, and its contents.
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import NoteMeta from '../components/NoteMeta.astro';
import Sidebar from '../components/Sidebar.astro';
import { getNotebook, noteUrl } from '../lib/notebook';
import '../styles/note.css';

export async function getStaticPaths() {
  const { order } = await getNotebook();
  return order.map((note, i) => ({
    params: { slug: note.id },
    props: { note, prev: order[i - 1], next: order[i + 1] },
  }));
}

const { note, prev, next } = Astro.props;
const notebook = await getNotebook();
const { Content, headings } = await render(note);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<Base title={note.data.title} description={note.data.description} image={`/og/${note.id}.png`} type="article">
  <div class="mx-auto flex max-w-[1480px]">
    <aside class="sticky top-0 hidden h-screen w-[264px] shrink-0 overflow-y-auto px-5 py-8 lg:block">
      <a href="/" class="mb-8 block px-[10px] text-[15px] font-semibold tracking-[-0.035em] text-[#efefef] no-underline">
        {notebook.title}
      </a>
      <Sidebar currentId={note.id} />
    </aside>

    <div class="min-w-0 flex-1">
      <header class="flex items-center justify-between px-4 pt-4 lg:hidden">
        <a href="/" class="text-[15px] font-semibold tracking-[-0.035em] text-[#efefef] no-underline">{notebook.title}</a>
        <button class="icon-button" type="button" aria-label="Open notebook menu" data-menu-open>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
        </button>
      </header>

      <div class="flex justify-center gap-14 px-4 py-10 sm:px-10 lg:py-16">
        <main class="w-full max-w-[740px] min-w-0">
          <h1 class="m-0 text-[32px] leading-[1.2] font-medium tracking-[-0.035em] sm:text-[36px]">{note.data.title}</h1>
          <div class="mt-4 empty:hidden"><NoteMeta note={note} /></div>

          <article class="note mt-10">
            <Content />
          </article>

          {
            (prev || next) && (
              <nav aria-label="Previous and next notes" class="mt-20 flex justify-between gap-6">
                {prev ? (
                  <a href={noteUrl(prev)} class="group flex flex-col gap-1 no-underline">
                    <span class="text-[12px] text-[#6f6f6f]">Previous</span>
                    <span class="text-[14px] font-medium text-[#cfcfcf] group-hover:text-white">{prev.data.title}</span>
                  </a>
                ) : <span />}
                {next && (
                  <a href={noteUrl(next)} class="group flex flex-col items-end gap-1 text-right no-underline">
                    <span class="text-[12px] text-[#6f6f6f]">Next</span>
                    <span class="text-[14px] font-medium text-[#cfcfcf] group-hover:text-white">{next.data.title}</span>
                  </a>
                )}
              </nav>
            )
          }
        </main>

        {
          toc.length > 0 && (
            <aside class="sticky top-16 hidden max-h-[calc(100vh-8rem)] w-[200px] shrink-0 self-start overflow-y-auto xl:block">
              <nav aria-label="On this page" data-toc>
                <p class="mb-3 text-[12px] font-medium text-[#6f6f6f]">On this page</p>
                <ul class="flex flex-col gap-2">
                  {toc.map((h) => (
                    <li class={h.depth === 3 ? 'pl-3' : ''}>
                      <a href={`#${h.slug}`} class="toc-link block text-[12.5px] leading-[1.45] text-[#7d7d7d] no-underline hover:text-white">
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </aside>
          )
        }
      </div>
    </div>
  </div>

  <dialog class="menu-dialog" aria-label="Notebook" data-menu>
    <div class="flex items-center justify-between px-4 pt-4">
      <a href="/" class="text-[15px] font-semibold tracking-[-0.035em] text-[#efefef] no-underline">{notebook.title}</a>
      <button class="icon-button" type="button" aria-label="Close notebook menu" data-menu-close>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
      </button>
    </div>
    <div class="px-[6px] py-8"><Sidebar currentId={note.id} /></div>
  </dialog>
</Base>

<style>
  .toc-link.is-active { color: #fff; }
</style>

<script>
  // Mobile notebook menu
  const menu = document.querySelector<HTMLDialogElement>('[data-menu]')!;
  document.querySelector('[data-menu-open]')?.addEventListener('click', () => menu.showModal());
  document.querySelector('[data-menu-close]')?.addEventListener('click', () => menu.close());
  matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && menu.close());

  // Copy button on every code block
  const copyIcon = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>';
  const checkIcon = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';
  for (const pre of document.querySelectorAll<HTMLPreElement>('.note pre')) {
    const block = document.createElement('div');
    block.className = 'code-block';
    pre.replaceWith(block);
    block.append(pre);
    const anchor = document.createElement('span');
    anchor.className = 'code-copy tooltip-anchor';
    anchor.innerHTML = `<span class="tooltip" aria-hidden="true">Copy</span><button class="icon-button is-small" type="button" aria-label="Copy code">${copyIcon}</button>`;
    block.append(anchor);
    const button = anchor.querySelector('button')!;
    const tip = anchor.querySelector('.tooltip')!;
    let timer: number | undefined;
    button.addEventListener('click', async () => {
      const code = [...pre.querySelectorAll('.line')].map((line) => line.textContent).join('\n') || pre.innerText;
      try {
        await navigator.clipboard.writeText(code);
      } catch {
        return;
      }
      tip.textContent = 'Copied';
      button.innerHTML = checkIcon;
      button.setAttribute('aria-label', 'Copied');
      anchor.classList.add('is-shown');
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        tip.textContent = 'Copy';
        button.innerHTML = copyIcon;
        button.setAttribute('aria-label', 'Copy code');
        anchor.classList.remove('is-shown');
      }, 1600);
    });
  }

  // Highlight the section being read in "On this page"
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc] .toc-link')];
  const targets = links.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))));
  let frame = 0;
  const spy = () => {
    frame = 0;
    let current = 0;
    targets.forEach((el, i) => el && el.getBoundingClientRect().top < 120 && (current = i));
    links.forEach((link, i) => link.classList.toggle('is-active', i === current));
  };
  if (links.length) {
    addEventListener('scroll', () => (frame ||= requestAnimationFrame(spy)), { passive: true });
    spy();
  }
</script>
