---
// One page per blog post (/hello) and per notebook note (/cp/math/fast-power).
import Base from '../layouts/Base.astro';
import NotebookPage from '../layouts/NotebookPage.astro';
import Article from '../components/Article.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getNotebooks } from '../lib/notebook';
import { getPosts } from '../lib/site';

export async function getStaticPaths() {
  const notes = (await getNotebooks()).flatMap((notebook) =>
    notebook.order.map((note, i, order) => ({
      params: { slug: note.id },
      props: { kind: 'note' as const, entry: note, notebook, prev: order[i - 1], next: order[i + 1] },
    })),
  );
  const posts = (await getPosts()).map((post) => ({
    params: { slug: post.id },
    props: { kind: 'post' as const, entry: post },
  }));
  return [...notes, ...posts];
}

const props = Astro.props;
---

{
  props.kind === 'note' ? (
    <NotebookPage notebook={props.notebook} note={props.entry}>
      <Article entry={props.entry} prev={props.prev} next={props.next} />
    </NotebookPage>
  ) : (
    <Base title={props.entry.data.title} description={props.entry.data.description} image={`/og/${props.entry.id}.png`} type="article">
      <div class="mx-auto max-w-[1120px] px-4 pt-8 sm:px-10">
        <SiteHeader />
      </div>
      <Article entry={props.entry} />
    </Base>
  )
}
