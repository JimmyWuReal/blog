---
// Posts and notes with one tag: posts newest first, then notes in notebook order.
import Listing from '../../layouts/Listing.astro';
import NoteGrid from '../../components/NoteGrid.astro';
import { countEntries, getTags } from '../../lib/site';

export async function getStaticPaths() {
  return [...(await getTags())].map(([tag, entries]) => ({ params: { tag }, props: { entries } }));
}

const { tag } = Astro.params;
const { entries } = Astro.props;
---

<Listing title={tag} image={`/og/tags/${encodeURIComponent(tag)}.png`}>
  <h1 class="m-0 text-[32px] leading-[1.15] font-medium tracking-[-0.045em] sm:text-[36px]">{tag}</h1>
  <p class="mt-3 text-[14px] text-[#7d7d7d]">{countEntries(entries)}</p>
  <div class="mt-8"><NoteGrid items={entries} /></div>
</Listing>
