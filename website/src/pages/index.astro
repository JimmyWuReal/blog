---
// Home: every notebook, then every blog post, newest first.
import Listing from '../layouts/Listing.astro';
import NoteGrid from '../components/NoteGrid.astro';
import { getNotebooks } from '../lib/notebook';
import { SITE_TITLE, getPosts, plural } from '../lib/site';

const notebooks = await getNotebooks();
const posts = await getPosts();
---

<Listing>
  <h1 class="sr-only">{SITE_TITLE}</h1>
  <div class="flex flex-col gap-14">
    <section class="flex flex-col gap-5">
      <h2 class="m-0 text-[24px] leading-[1.3] font-medium tracking-[-0.035em]">Notebooks</h2>
      <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3">
        {
          notebooks.map((notebook) => (
            <li class="relative flex flex-col gap-2 rounded-2xl bg-[#111] p-5 hover:bg-[#161616]">
              <a href={`/${notebook.slug}`} class="text-[15px] font-medium tracking-[-0.01em] text-[#efefef] no-underline after:absolute after:inset-0 after:rounded-2xl">
                {notebook.title}
              </a>
              {notebook.description && <p class="m-0 line-clamp-2 text-[12.5px] leading-[1.7] text-[#7d7d7d]">{notebook.description}</p>}
              <span class="mono-value mt-auto pt-2 text-[#6f6f6f]">{plural(notebook.order.length, 'note')}</span>
            </li>
          ))
        }
      </ul>
    </section>

    {
      posts.length > 0 && (
        <section class="flex flex-col gap-5">
          <h2 class="m-0 text-[24px] leading-[1.3] font-medium tracking-[-0.035em]">Posts</h2>
          <NoteGrid items={posts} />
        </section>
      )
    }
  </div>
</Listing>
