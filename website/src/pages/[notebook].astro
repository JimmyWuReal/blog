---
// A notebook's contents page (/cp): every section and note from its notebook.yml, as card grids.
import Listing from '../layouts/Listing.astro';
import NoteGrid from '../components/NoteGrid.astro';
import { getNotebooks, type Notebook } from '../lib/notebook';

export async function getStaticPaths() {
  return (await getNotebooks()).map((notebook) => ({ params: { notebook: notebook.slug }, props: { notebook } }));
}

const { notebook } = Astro.props as { notebook: Notebook };
---

<Listing title={notebook.title} description={notebook.description} image={`/og/${notebook.slug}.png`}>
  <h1 class="m-0 text-[32px] leading-[1.15] font-medium tracking-[-0.045em] sm:text-[36px]">{notebook.title}</h1>
  {notebook.description && <p class="mt-3 text-[14px] text-[#7d7d7d]">{notebook.description}</p>}
  <div class="mt-14 flex flex-col gap-14">
    {
      notebook.sections.map((section) => (
        <section class="flex flex-col gap-5">
          <h2 class="m-0 text-[24px] leading-[1.3] font-medium tracking-[-0.035em]">{section.title}</h2>
          <NoteGrid items={section.items} />
        </section>
      ))
    }
  </div>
</Listing>
